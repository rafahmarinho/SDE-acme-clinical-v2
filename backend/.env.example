# Example environment variables for the API. Copy to .env; never commit real values.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-public-key>
# Server-only secret. Never expose to the frontend.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
SUPABASE_JWT_SECRET=<jwt-secret>
DATABASE_URL=postgresql://acme_api:<password>@<host>:5432/postgres?sslmode=require
CORS_ALLOWED_ORIGINS=https://<frontend>.vercel.app
APP_ENV=development
