# Example environment variables for the API. Copy to backend/.env for LOCAL development only (.env is
# git-ignored). In Vercel set them under Project > Settings > Environment Variables and mark every secret
# as "Sensitive". Placeholders (<...>) are rejected at start-up. Reference: docs/security/secure-config.md

# production (default when unset): docs off, https only, start-up refuses unprotected routes.
APP_ENV=development
# Interactive docs outside production only (ignored when APP_ENV=production).
ENABLE_DOCS=false

SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-public-key>
# Server-only secrets. Never expose to the frontend, never prefix with VITE_.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
SUPABASE_JWT_SECRET=<jwt-secret>
# Least-privilege API role; TLS with certificate verification is mandatory (sslmode=verify-full).
DATABASE_URL=postgresql://acme_api:<password>@<host>:5432/postgres?sslmode=verify-full&sslrootcert=system
# Exact SPA origins (https), comma-separated. Never "*".
CORS_ALLOWED_ORIGINS=https://<frontend>.vercel.app
# Host header allow-list (comma-separated exact names or *.suffix). Empty = *.vercel.app and localhost.
ALLOWED_HOSTS=
# Optional dedicated key material (leave empty to derive from SUPABASE_JWT_SECRET; set both in production).
# EC P-521 private key in PEM (\n-escaped) used to sign audit records; publish the public key via /v1/events/signing-key.
AUDIT_SIGNING_KEY=
# >= 32 random characters: HMAC key protecting alarm limits and simulation state against direct DB tampering.
CONFIG_INTEGRITY_KEY=
