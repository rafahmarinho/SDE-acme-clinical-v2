# Public (browser-exposed) values only. Everything prefixed VITE_ is bundled into the SPA.
# Never place the Supabase service role key, JWT secret or database URL here.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-public-key>
VITE_API_BASE_URL=https://<api>.vercel.app
